# Server identity
SERVER_NAME=mcp-shadow
TZ=UTC

# MCP HTTP endpoint
MCP_BIND_ADDRESS=127.0.0.1
MCP_PORT=8010
# Optional exact, comma-separated additions to the built-in Host and Origin lists.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=

# Persistent state and filesystem monitoring
MCP_STATE_PATH=./state
DISK_PROBE_SOURCE=./disk-probe

# External Docker network shared with MCP clients
MONITORING_NETWORK=homelab-monitoring

# Optional analysis and failure suppression
ANALYSIS_PROVIDER=ollama
ANALYSIS_FAILURE_THRESHOLD=2
ANALYSIS_COOLDOWN_SECONDS=30

# Ollama
OLLAMA_API_BASE=http://ollama:11434
OLLAMA_MODEL=qwen3.5
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_MAX_INPUT_CHARS=5000
OLLAMA_THINK=false
OLLAMA_TEMPERATURE=0

# Observability limits
MAX_LOG_LINES=200
MAX_LOG_CHARS=50000
DIAGNOSTIC_CACHE_TTL_SECONDS=120
DOCKER_WORKERS=4
# Exact Docker names expected to exist; this does not bypass the enabled label.
EXPECTED_CONTAINER_NAMES=
METRIC_MAX_AGE_SECONDS=300
SUSTAINED_METRIC_SAMPLES=3
SUSTAINED_MIN_DURATION_SECONDS=120
SUSTAINED_MAX_SAMPLE_GAP_SECONDS=300
LOG_SPOOL_MAX_BYTES=268435456
LOG_SPOOL_TOTAL_MAX_BYTES=1073741824
LOG_SPOOL_MIN_FREE_BYTES=67108864
